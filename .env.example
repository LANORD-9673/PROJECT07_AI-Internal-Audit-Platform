# React / FastAPI: copy to .env for START_REACT.bat; cloud uses service environment variables.
GEMINI_API_KEY=
PROJECT07_GEMINI_MODEL=gemini-3.8-flash
PROJECT07_GEMINI_TIMEOUT=180
PROJECT07_GEMINI_MAX_RETRIES=2
PROJECT07_APPROVED_BASELINE_SHA256=
PROJECT07_APPROVED_AUTHORITY_SHA256=
PROJECT07_AUTHORITY_APPROVAL_REFERENCE=
PROJECT07_VAULT_MASTER_KEY=
# Set DB and vault paths to a persistent mount on your hosting service.
# PROJECT07_DB_PATH=/app/storage/project07.sqlite3
# PROJECT07_VAULT_DIR=/app/storage/private_vault
